{
  "name": "tudou",
  "productName": "Tudou",
  "version": "0.1.21",
  "description": "Multi-agent dashboard for orchestrating Claude Code, Codex, and other AI CLI sessions in one window.",
  "private": true,
  "main": "dist/electron/main.js",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dev": "concurrently -k -n NEXT,ELEC -c blue,green \"npm:dev:next\" \"npm:dev:electron\"",
    "dev:next": "next dev renderer -p 3000",
    "dev:electron": "wait-on tcp:3000 && npm run build:electron && cross-env NODE_ENV=development electron .",
    "build": "npm run build:next && npm run build:electron",
    "build:next": "next build renderer",
    "build:electron": "tsc -p electron/tsconfig.json",
    "package": "npm run build && electron-builder --mac",
    "package:arm": "npm run build && electron-builder --mac --arm64",
    "repackage": "node scripts/repackage.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc -p electron/tsconfig.json --noEmit && tsc -p renderer/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.tudou.app",
    "productName": "Tudou",
    "copyright": "Copyright © 2026 Tudou",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "renderer/out/**/*",
      "scripts/fix-node-pty.mjs",
      "package.json",
      "!**/*.{ts,tsx,map}",
      "!**/tsconfig*.json",
      "!**/__tests__/**",
      "!tests/**",
      "!docs/**",
      "!coverage/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/build/**",
      "node_modules/node-pty/prebuilds/**"
    ],
    "afterPack": "scripts/after-pack-fix-pty.mjs",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Tudou ${version} ${arch}",
      "writeUpdateInfo": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Liko209",
        "repo": "tudou",
        "releaseType": "draft"
      }
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@xterm/addon-fit": "^0.12.0-beta.261",
    "@xterm/addon-unicode11": "^0.10.0-beta.261",
    "@xterm/addon-web-links": "^0.13.0-beta.261",
    "@xterm/addon-webgl": "^0.20.0-beta.260",
    "@xterm/xterm": "^6.1.0-beta.261",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "jsdom": "^29.1.1",
    "next": "^15.1.0",
    "postcss": "^8.5.15",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.13"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.17.0",
    "node-pty": "^1.1.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1"
  }
}
