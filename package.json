{
  "name": "agent-dashboard",
  "version": "0.1.0",
  "description": "Unified macOS dashboard for hosting AI CLI sessions (Claude Code, Codex)",
  "private": true,
  "main": "dist/electron/main.js",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dev": "concurrently -k -n NEXT,ELEC -c blue,green \"npm:dev:next\" \"npm:dev:electron\"",
    "dev:next": "next dev renderer -p 3000",
    "dev:electron": "wait-on tcp:3000 && npm run build:electron && cross-env NODE_ENV=development electron .",
    "build": "npm run build:next && npm run build:electron",
    "build:next": "next build renderer",
    "build:electron": "tsc -p electron/tsconfig.json",
    "package": "npm run build && electron-builder --mac",
    "typecheck": "tsc -p electron/tsconfig.json --noEmit && tsc -p renderer/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "jsdom": "^29.1.1",
    "next": "^15.1.0",
    "node-pty": "^1.1.0",
    "postcss": "^8.5.15",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.13"
  },
  "dependencies": {
    "chokidar": "^3.6.0"
  }
}
